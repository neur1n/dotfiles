alias gcm = git commit

alias gco = git checkout

alias glg = git log --all --abbrev-commit --decorate --graph --format=format:'%C(bold blue)%h%C(reset) - %C(bold cyan)%ai%C(reset) %C(bold green)(%ar)%C(reset)%C(bold yellow)%d%C(reset)%n          %C(white)%s%C(reset) %C(dim white)- %an%C(reset)'

alias gst = git status
