keybinds preset="unlock-first" unlock="Alt g" {
  unbind "Alt h"
  unbind "Alt j"
  unbind "Alt k"
  unbind "Alt l"
  unbind "Ctrl q"

  shared_except "locked" "renametab" "renamepane" "renamesession" {
    bind "Alt q" {Quit;}
  }
}

default_shell "nu"
pane_frame_style "full"
scroll_mode_sync false
theme "night-owl"

ui {
  pane_frames {
    border_style "heavy"
  }
}
