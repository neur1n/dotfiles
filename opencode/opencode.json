{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": "notify",
  "default_agent": "plan",
  "lsp": false,
  "permission": {
    "bash": {
      "git blame *": "allow",
      "git cat-file *": "allow",
      "git describe": "allow",
      "git describe *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git grep *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git ls-files": "allow",
      "git ls-files *": "allow",
      "git ls-tree *": "allow",
      "git merge-base *": "allow",
      "git rev-list *": "allow",
      "git rev-parse *": "allow",
      "git show": "allow",
      "git show *": "allow",
      "git shortlog": "allow",
      "git shortlog *": "allow",
      "git status": "allow",
      "git status *": "allow",
      "*": "ask"
    }
  },
  "snapshot": false,
  "plugin": [
    "@mohak34/opencode-notifier@latest",
    "@slkiser/opencode-quota@latest"
  ],
  "provider": {
    "openai": {}
  }
}
